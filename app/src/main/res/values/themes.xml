<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fundo preto desde o primeiro frame, para não piscar branco ao abrir. -->
    <style name="Theme.VoidTouch" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <!-- Permite mostrar o papel de parede do sistema por trás (modo Wallpaper). -->
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
