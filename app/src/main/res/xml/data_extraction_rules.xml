<?xml version="1.0" encoding="utf-8"?>
<!-- Nada do VoidTouch vai para o backup na nuvem nem para a transferência entre aparelhos.
     O backup é o arquivo que você mesmo salva em Ajustes. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
